---
import PostListItem from "@/components/PostListItem.astro";
import Layout from "@/layouts/Layout.astro";
import { getPostsByTag, getSortedBlogTags } from "@/lib/utils";

export async function getStaticPaths() {
  const tags = await getSortedBlogTags();

  return tags.map(({ tag }) => ({
    params: { tag },
  }));
}

const { tag } = Astro.params;
const posts = await getPostsByTag(tag as string);

---

<Layout title={`#${tag}`} description={`Posts tagged with #${tag}`}>
  <section class="mt-10">
    <h2 class="font-semibold mb-6">#{tag}</h2>
    <ul>
      {posts.map((post) => (
        <PostListItem post={post} />
      ))}
    </ul>
  </section>
</Layout>
