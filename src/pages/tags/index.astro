---
import Layout from "@/layouts/Layout.astro";
import { getSortedBlogTags } from "@/lib/utils";

const tags = await getSortedBlogTags();
---

<Layout title="Tags" description="All tags">
  <section class="mt-10">
    <h2 class="font-semibold mb-6">Tags</h2>
    <ul>
      {
        tags.map(({ tag, count }) => (
          <li class="mx-4 my-2 inline-block">
            <a href={`/tags/${encodeURIComponent(tag)}`} class="link-hover">
              #{tag} · {count}
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</Layout>
